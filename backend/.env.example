PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017/hireflow_ats

# JWT Authentication
JWT_ACCESS_SECRET=hireflow_super_secret_access_key_2026_change_in_production
JWT_REFRESH_SECRET=hireflow_super_secret_refresh_key_2026_change_in_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# File Upload / Cloudinary (Leave empty to use local fallback storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Gemini API (Leave empty to use smart deterministic heuristic AI engine)
GEMINI_API_KEY=

# Email / SMTP (Leave empty to log emails to console)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="HireFlow ATS" <no-reply@hireflow.dev>
