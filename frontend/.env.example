# ==============================================================================
# HireFlow ATS - Frontend Environment Variables
# ==============================================================================

# API Base URL
# In development with Vite proxy, '/api/v1' automatically forwards to http://localhost:5000/api/v1
# For standalone CORS communication or production, set the full URL: http://localhost:5000/api/v1
VITE_API_URL=/api/v1

# Backend Origin (for static uploads / resume links)
VITE_BACKEND_URL=http://localhost:5000

# Application Branding
VITE_APP_NAME=HireFlow ATS
